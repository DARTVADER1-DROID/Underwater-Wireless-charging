flowchart TB
    VP["+12 V battery bus"] --> Q1["Q1 high-side MOSFET"]
    VP --> Q3["Q3 high-side MOSFET"]
    Q1 --> A["Switch node A"]
    Q2["Q2 low-side MOSFET"] --> A
    Q3 --> B["Switch node B"]
    Q4["Q4 low-side MOSFET"] --> B
    A <-->|"TX resonant branch"| B
    Q2 --> GN["Battery negative"]
    Q4 --> GN
    CTRL["Interlock / dead-time logic"] --> DA["Half-bridge driver A"]
    CTRL --> DB["Half-bridge driver B"]
    DA -.-> Q1
    DA -.-> Q2
    DB -.-> Q3
    DB -.-> Q4
    NOTE["Positive: Q1 + Q4 ON<br/>Negative: Q2 + Q3 ON<br/>Never turn ON both devices in one leg"]
    NOTE --- A
